<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ ignores android:allowBackup for some transfer paths unless rules are declared.
    Nothing from this app (credentials, encryption keys, sync database) may leave the device
    through cloud backup or device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
